{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CoverArt",
  "version": "0.1.0",
  "identifier": "com.coverart.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "CoverArt",
        "width": 560,
        "height": 560,
        "resizable": false,
        "maximizable": false,
        "decorations": false,
        "transparent": false,
        "shadow": true,
        "center": true,
        "skipTaskbar": false,
        "alwaysOnTop": false,
        "visible": false
      }
    ],
    "withGlobalTauri": true,
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPDATA/covers/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ]
  }
}
